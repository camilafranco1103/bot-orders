# Copiá este archivo a .env y completá los valores. NUNCA subas el .env al repo.

# --- Base de datos (PostgreSQL en Supabase) ---
# Supabase > Connect > ORMs > Prisma. Cambiá [PASSWORD] y [REGION]/[PROJECT-REF] por los tuyos.
# Conexión por el pooler (transaction mode, puerto 6543): la usa la app en runtime.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa/session (puerto 5432): la usan las migraciones y el seed.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Auth.js (login del panel) ---
# Generar con: npx auth secret
AUTH_SECRET=""
# URL pública de la app (en local: http://localhost:3000).
AUTH_URL="http://localhost:3000"

# Usuario dueño que crea el seed. La contraseña necesita 8 caracteres o más.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
# Opcional: un usuario empleado para probar los permisos (con otro email).
SEED_EMPLOYEE_EMAIL=""
SEED_EMPLOYEE_PASSWORD=""

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Texto que elegís vos; Meta lo usa para verificar el webhook.
WHATSAPP_VERIFY_TOKEN=""
# Secreto de la app de Meta, para validar la firma de los webhooks.
WHATSAPP_APP_SECRET=""

# --- IA (solo para interpretar la intención del cliente) ---
LLM_API_KEY=""
LLM_MODEL=""

# --- Tareas programadas (cron de Vercel) ---
# Los endpoints de cron exigen este secreto en el header Authorization.
CRON_SECRET=""
